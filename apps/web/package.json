{
  "name": "@datara/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "map:update": "node scripts/update-map.mjs",
    "map:check": "node scripts/check-map.mjs && node scripts/check-us-map.mjs && node scripts/check-map-location.mjs",
    "map:update:us": "node --max-old-space-size=8192 scripts/update-us-map.mjs",
    "api:types": "pnpm --silent --filter @datara/api openapi:export ../web/.generated/openapi.json && openapi-typescript .generated/openapi.json -o src/features/elections/api-types.generated.ts && prettier --write src/features/elections/api-types.generated.ts",
    "api:types:check": "node scripts/check-api-types.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@datara/theme": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "d3-geo": "3.1.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "lucide-react": "^1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.1",
    "topojson-client": "3.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@datara/eslint": "workspace:*",
    "@datara/prettier": "workspace:*",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-geo": "3.1.1",
    "@types/d3-selection": "3.0.12",
    "@types/d3-zoom": "3.0.9",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.12.0",
    "mapshaper": "0.7.76",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "topojson-server": "3.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
