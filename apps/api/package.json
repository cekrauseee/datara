{
  "name": "@datara/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc && cp src/db/*.sql dist/db/",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "elections": "node --env-file-if-exists=.env --import tsx scripts/elections.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/elections.ts --migrate",
    "check:bu": "tsx scripts/check-bu.ts",
    "check:ingestion": "tsx scripts/check-ingestion.ts",
    "check:acquisition": "tsx scripts/check-acquisition.ts",
    "check:api": "tsx scripts/check-api.ts",
    "check:presentation": "node --env-file-if-exists=.env --import tsx scripts/check-presentation.ts",
    "elections:photos": "node --env-file-if-exists=.env --import tsx scripts/election-photos.ts",
    "check:photos": "tsx scripts/check-photos.ts",
    "check:settings": "tsx scripts/check-settings.ts",
    "check:local": "tsx scripts/check-local.ts",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@datara/eslint": "workspace:*",
    "@datara/prettier": "workspace:*",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
