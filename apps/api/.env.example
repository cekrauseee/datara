DATABASE_URL=postgresql://localhost:5432/datara
# Managed local PostgreSQL; setup fills these when DATABASE_URL is not supplied.
# LOCAL_POSTGRES_DIR=/absolute/path/postgres
# LOCAL_POSTGRES_PORT=55431
# Optional PostgreSQL 18 binary directory when not available on PATH.
# PG_BIN=/absolute/path/bin
# Persistent original TSE documents; backup together with PostgreSQL.
ELECTION_ARCHIVE_DIR=../../.data/elections
PORT=3000
CORS_ORIGIN=http://localhost:5173
ASSET_BASE_URL=/assets
# Optional durable overrides; PHOTO_DIRECTORY contains a photos/ subdirectory.
# ELECTION_PRESENTATION_FILE=/absolute/path/election-presentation.json
# PHOTO_DIRECTORY=/absolute/path/public
