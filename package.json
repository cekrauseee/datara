{
  "name": "datara",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/scripts/local.ts dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/scripts/local.ts setup",
    "dev:stop": "node --import ./apps/api/node_modules/tsx/dist/loader.mjs apps/api/scripts/local.ts stop",
    "docs:dev": "pnpm --filter @datara/docs dev",
    "docs:start": "pnpm --filter @datara/docs start"
  },
  "devDependencies": {
    "@datara/prettier": "workspace:*",
    "prettier": "3.9.9",
    "turbo": "2.11.7"
  }
}
